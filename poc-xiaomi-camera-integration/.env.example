################################################
# PoC – Xiaomi Camera Integration
################################################

# Backend server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Log level: debug, info, warning, error
SERVER_LOG_LEVEL=info

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# OAuth2 redirect URI
# MUST match one of the URIs registered in the Xiaomi OAuth2 Service.
# For default miot_kit client_id, valid values are:
#   - https://127.0.0.1
#   - https://mico.api.mijia.tech/login_redirect
# Note: https://localhost/... is rejected by Xiaomi with "invalid redirect uri".
OAUTH2_REDIRECT_URI=https://127.0.0.1

# Xiaomi cloud server region: cn, de, us, ru, tw, sg, in, i2
CLOUD_SERVER=de

# Camera stream frame interval in milliseconds (lower = more CPU usage)
FRAME_INTERVAL=500
